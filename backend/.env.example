# KRISHI-MITRA Backend Environment Configuration
# Copy this file to .env and configure appropriate values for your environment.
# NEVER commit the active .env file or real credentials to Git.

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend CORS Origin (comma-separated if multiple)
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Database Configuration (Active — Stage 3)
# MongoDB Atlas Connection String
# Required in production; optional in initial development (gateway runs disconnected if omitted)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/krishi_mitra?retryWrites=true&w=majority
ALLOW_MEMORY_DB=true

# Authentication & Security (Reserved for Stage 4)
JWT_SECRET=your_development_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
GUEST_SESSION_SECRET=your_guest_session_secret_for_signing_tokens

# Open Satellite Data Credentials
# Earthdata Login is required for AppEEARS task submission and bundle download.
# Public catalogue search operates without credentials; AppEEARS reports AWAITING_CREDENTIALS if unconfigured.
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password
EARTHDATA_TOKEN=your_earthdata_bearer_token_optional
APPEEARS_BASE_URL=https://appeears.earthdatacloud.nasa.gov/api
CMR_BASE_URL=https://cmr.earthdata.nasa.gov/search
SATELLITE_TIMEOUT_MS=15000
SATELLITE_CACHE_TTL_MS=86400000

# IMD API Credentials (Active — Stage 5)
# If omitted or unconfigured, IMD endpoints safely report AWAITING_CREDENTIALS status.
IMD_API_BASE_URL=https://api.imd.gov.in/api/v1
IMD_API_KEY=your_imd_api_key_here
IMD_BEARER_TOKEN=your_imd_jwt_bearer_token_here
IMD_TIMEOUT_MS=10000

# Google Earth Engine REST API Integration (API 8)
# Discovery URL is public (no credentials required to fetch discovery metadata).
# Computation and raster endpoints require a registered Google Cloud Project ID and Service Account key.
# If unconfigured, the integration boundary safely reports PROJECT_CONFIGURATION_REQUIRED / AUTH_REQUIRED.
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
EARTH_ENGINE_BASE_URL=https://earthengine.googleapis.com/v1
EARTH_ENGINE_TIMEOUT_MS=15000

# Report Storage & Cloud Object Storage (Active — Report Generation)
REPORT_STORAGE_PROVIDER=LOCAL
REPORT_STORAGE_BUCKET=
REPORT_STORAGE_REGION=
REPORT_STORAGE_ENDPOINT=
REPORT_STORAGE_ACCESS_KEY=
REPORT_STORAGE_SECRET_KEY=
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
